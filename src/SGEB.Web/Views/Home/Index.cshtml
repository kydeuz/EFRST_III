@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-5">
    <i class="bi bi-fire display-3" style="color: var(--sgeb-rojo)"></i>
    <h1 class="display-5 fw-bold mb-1">SGEB</h1>
    <p class="lead text-muted mb-0">Sistema de Gestión de Emergencias de Bomberos</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">

    <div class="col">
        <div class="card card-modulo h-100 text-center">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-exclamation-triangle-fill fs-1 mb-2" style="color: var(--sgeb-rojo)"></i>
                <h5 class="card-title">Incidentes</h5>
                <p class="card-text text-muted">Registrar y consultar incidentes reportados.</p>
                <a asp-controller="Incidente" asp-action="Index" class="btn btn-primary mt-auto">Entrar</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card card-modulo h-100 text-center">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-truck fs-1 mb-2" style="color: var(--sgeb-rojo)"></i>
                <h5 class="card-title">Unidades</h5>
                <p class="card-text text-muted">Catálogo y asignación de unidades a incidentes.</p>
                <a asp-controller="Unidad" asp-action="Index" class="btn btn-primary mt-auto">Entrar</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card card-modulo h-100 text-center">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-clipboard-check-fill fs-1 mb-2" style="color: var(--sgeb-rojo)"></i>
                <h5 class="card-title">Atención / Cierre</h5>
                <p class="card-text text-muted">Registro de la atención, cierre y resultado de un incidente.</p>
                <a asp-controller="AtencionCierre" asp-action="Index" class="btn btn-primary mt-auto">Entrar</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card card-modulo h-100 text-center">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-bar-chart-line-fill fs-1 mb-2" style="color: var(--sgeb-rojo)"></i>
                <h5 class="card-title">Reportes</h5>
                <p class="card-text text-muted">Estadísticas y exportación a PDF, Excel y CSV.</p>
                <a asp-controller="Reporte" asp-action="PorTipo" class="btn btn-primary mt-auto">Entrar</a>
            </div>
        </div>
    </div>

</div>