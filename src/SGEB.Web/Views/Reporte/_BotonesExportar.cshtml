@model string

<div class="mb-3">
    <span class="me-2">Descargar:</span>
    <a class="btn btn-sm btn-danger" asp-action="Exportar" asp-route-reporte="@Model" asp-route-formato="pdf">PDF</a>
    <a class="btn btn-sm btn-success" asp-action="Exportar" asp-route-reporte="@Model" asp-route-formato="excel">Excel</a>
    <a class="btn btn-sm btn-secondary" asp-action="Exportar" asp-route-reporte="@Model" asp-route-formato="csv">CSV</a>
</div>