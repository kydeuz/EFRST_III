@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model List<SGEB.Web.Models.AtencionIncidenteViewModel>

@{
    ViewData["Title"] = "Atención y cierre";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Atención y cierre de incidentes</h1>
        <p class="text-muted">
            Registre la atención y el cierre de los incidentes.
        </p>
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Volver al inicio
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">
        No existen incidentes registrados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th>Dirección</th>
                    <th>Zona</th>
                    <th>Reportante</th>
                    <th>Prioridad</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var incidente in Model)
                {
                    <tr>
                        <td>@incidente.IdIncidente</td>
                        <td>@incidente.TipoIncidente</td>
                        <td>@incidente.Descripcion</td>
                        <td>@incidente.Direccion</td>
                        <td>@incidente.Zona</td>
                        <td>@incidente.NombreReportante</td>

                        <td>
                            @if (incidente.Prioridad == "Alta")
                            {
                                <span class="badge bg-danger">Alta</span>
                            }
                            else if (incidente.Prioridad == "Media")
                            {
                                <span class="badge bg-warning text-dark">
                                    Media
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">Baja</span>
                            }
                        </td>

                        <td>
                            @if (incidente.Estado == "Registrado")
                            {
                                <span class="badge bg-secondary">
                                    Registrado
                                </span>
                            }
                            else if (incidente.Estado == "Asignado")
                            {
                                <span class="badge bg-primary">
                                    Asignado
                                </span>
                            }
                            else if (incidente.Estado == "Atendido")
                            {
                                <span class="badge bg-info text-dark">
                                    Atendido
                                </span>
                            }
                            else if (incidente.Estado == "Cerrado")
                            {
                                <span class="badge bg-dark">
                                    Cerrado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @incidente.Estado
                                </span>
                            }
                        </td>

                        <td>
                            @incidente.FechaHoraRegistro.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @if (incidente.Estado == "Asignado")
                            {
                                <form asp-controller="AtencionCierre"
                                      asp-action="MarcarAtendido"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="idIncidente"
                                           value="@incidente.IdIncidente" />

                                    <button type="submit"
                                            class="btn btn-success btn-sm"
                                            onclick="return confirm('¿Desea marcar este incidente como atendido?');">
                                        Marcar atendido
                                    </button>
                                </form>
                            }
                            else if (incidente.Estado == "Atendido")
                            {
                                <a asp-controller="AtencionCierre"
                                   asp-action="Cerrar"
                                   asp-route-id="@incidente.IdIncidente"
                                   class="btn btn-danger btn-sm">
                                    Registrar cierre
                                </a>
                            }
                            else if (incidente.Estado == "Registrado")
                            {
                                <span class="text-muted">
                                    Pendiente de asignación
                                </span>
                            }
                            else if (incidente.Estado == "Cerrado")
                            {
                                <span class="text-success fw-semibold">
                                    Finalizado
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
