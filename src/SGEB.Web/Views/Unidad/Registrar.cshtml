@model SGEB.Web.Models.RegistrarUnidadViewModel

@{
    ViewData["Title"] = "Registrar unidad";
}

<h1>Registrar unidad</h1>

<form asp-action="Registrar" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CodigoUnidad" class="form-label"></label>
        <input asp-for="CodigoUnidad" class="form-control" placeholder="Ej. B-05" />
        <span asp-validation-for="CodigoUnidad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TipoUnidad" class="form-label"></label>
        <select asp-for="TipoUnidad" class="form-select">
            <option value="">-- Seleccione --</option>
            <option value="Autobomba">Autobomba</option>
            <option value="Ambulancia">Ambulancia</option>
            <option value="Escalera">Escalera</option>
            <option value="Rescate">Rescate</option>
            <option value="Materiales Peligrosos">Materiales Peligrosos</option>
        </select>
        <span asp-validation-for="TipoUnidad" class="text-danger"></span>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="Placa" class="form-label"></label>
            <input asp-for="Placa" class="form-control" />
            <span asp-validation-for="Placa" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="Capacidad" class="form-label"></label>
            <input asp-for="Capacidad" class="form-control" />
            <span asp-validation-for="Capacidad" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Estacion" class="form-label"></label>
        <input asp-for="Estacion" class="form-control" />
        <span asp-validation-for="Estacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar unidad</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
