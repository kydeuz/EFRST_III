@model List<SGEB.Web.Models.UnidadListItemViewModel>

@{
    ViewData["Title"] = "Unidades";
    var estados = (string[])ViewBag.Estados;

    int disponibles = Model.Count(u => u.Estado == "Disponible");
    int enServicio = Model.Count(u => u.Estado == "En servicio");
    int mantenimiento = Model.Count(u => u.Estado == "Mantenimiento");
    int fueraServicio = Model.Count(u => u.Estado == "Fuera de servicio");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1"><i class="bi bi-truck"></i> Catálogo de unidades</h1>
        <p class="text-muted mb-0">Autobombas, ambulancias y demás unidades de la central.</p>
    </div>
    <a asp-action="Registrar" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nueva unidad
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Disponibles</div>
                <div class="fs-3 fw-semibold">@disponibles</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
            <div class="card-body py-3">
                <div class="text-muted small">En servicio</div>
                <div class="fs-3 fw-semibold">@enServicio</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
            <div class="card-body py-3">
                <div class="text-muted small">En mantenimiento</div>
                <div class="fs-3 fw-semibold">@mantenimiento</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card shadow-sm border-0 border-start border-4 border-dark h-100">
            <div class="card-body py-3">
                <div class="text-muted small">Fuera de servicio</div>
                <div class="fs-3 fw-semibold">@fueraServicio</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <i class="bi bi-truck fs-1 text-muted"></i>
            <p class="mt-3 mb-3 text-muted">Todavía no hay unidades registradas.</p>
            <a asp-action="Registrar" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Registrar la primera unidad
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Tipo</th>
                        <th>Placa</th>
                        <th>Capacidad</th>
                        <th>Estación</th>
                        <th>Estado</th>
                        <th>Registro</th>
                        <th>Cambiar estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var unidad in Model)
                    {
                        <tr>
                            <td class="fw-bold">@unidad.CodigoUnidad</td>
                            <td>@unidad.TipoUnidad</td>
                            <td>@(string.IsNullOrWhiteSpace(unidad.Placa) ? "—" : unidad.Placa)</td>
                            <td>
                                @if (unidad.Capacidad.HasValue)
                                {
                                    <i class="bi bi-people text-muted"></i> @unidad.Capacidad
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(unidad.Estacion) ? "—" : unidad.Estacion)</td>
                            <td><partial name="_BadgeEstado" model="unidad.Estado" /></td>
                            <td class="text-nowrap">@unidad.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (unidad.Estado == "En servicio")
                                {
                                    <span class="text-muted small">
                                        <i class="bi bi-lock"></i> Se libera desde el incidente
                                    </span>
                                }
                                else
                                {
                                    <form asp-action="CambiarEstado" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="idUnidad" value="@unidad.IdUnidad" />
                                        <select name="nuevoEstado" class="form-select form-select-sm">
                                            @foreach (var estado in estados)
                                            {
                                                <option value="@estado" selected="@(estado == unidad.Estado)">@estado</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-dark" title="Cambiar estado">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}