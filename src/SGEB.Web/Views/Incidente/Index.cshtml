@model List<SGEB.Web.Models.IncidenteListItemViewModel>

@{
    ViewData["Title"] = "Incidentes";
}

<div class="page-header">
    <h1><i class="bi bi-exclamation-triangle"></i> Incidentes registrados</h1>
    <a asp-action="Registrar" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo incidente</a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Todavía no hay incidentes registrados.
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tipo</th>
                        <th>Dirección</th>
                        <th>Zona</th>
                        <th>Reportante</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incidente in Model)
                    {
                        <tr class="@(incidente.Prioridad == "Alta" ? "fila-alta" : "")">
                            <td class="fw-semibold">@incidente.IdIncidente</td>
                            <td>@incidente.TipoIncidente</td>
                            <td>@incidente.Direccion</td>
                            <td>@incidente.Zona</td>
                            <td>@incidente.NombreReportante</td>
                            <td><partial name="_BadgePrioridad" model="incidente.Prioridad" /></td>
                            <td><partial name="_BadgeEstado" model="incidente.Estado" /></td>
                            <td class="text-nowrap">@incidente.FechaHoraRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-controller="IncidenteUnidad" asp-action="Index" asp-route-id="@incidente.IdIncidente"
                                    class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-truck"></i> Unidades
                                    </a>
                                    @if (incidente.Estado == "Atendido")
                                    {
                                        <a asp-controller="AtencionCierre" asp-action="Cerrar" asp-route-id="@incidente.IdIncidente"
                                        class="btn btn-sm btn-outline-danger"><i class="bi bi-check2-square"></i> Cerrar</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}