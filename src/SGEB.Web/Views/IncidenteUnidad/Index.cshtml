
@model AsignarUnidadViewModel

@{
    ViewData["Title"] = $"Unidades del incidente #{Model.IdIncidente}";

    var totalAsignadas = Model.Asignadas.Count();
    var totalActivas = Model.Asignadas.Count(a => a.Estado != "Liberada");
    var totalLiberadas = Model.Asignadas.Count(a => a.Estado == "Liberada");
}

